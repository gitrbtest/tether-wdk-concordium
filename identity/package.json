{
  "name": "@concordium/wdk-identity-concordium",
  "version": "0.0.0",
  "private": true,
  "description": "Concordium identity companion for the WDK wallet module: identity verification with an identity provider, encrypted identity storage, and account creation from a wallet seed.",
  "type": "module",
  "main": "index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./node": {
      "types": "./types/node.d.ts",
      "default": "./node-extras.js"
    },
    "./testing": {
      "types": "./types/testing.d.ts",
      "default": "./testing.js"
    }
  },
  "files": [
    "index.js",
    "node-extras.js",
    "testing.js",
    "docs",
    "src",
    "types",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/unit/*.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "fixtures": "node test/fixtures/capture.mjs",
    "check:providers": "node scripts/check-providers.mjs",
    "example:verify-identity": "node examples/verify-identity.mjs",
    "example:load-identity": "node examples/load-identity.mjs",
    "example:database-store": "node examples/database-store.mjs",
    "example:create-account": "node examples/create-account.mjs"
  },
  "keywords": [
    "wdk",
    "wallet",
    "concordium",
    "identity",
    "tether"
  ],
  "author": "Concordium",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Concordium/tether-wdk-concordium.git",
    "directory": "identity"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@concordium/rust-bindings": "4.0.1",
    "@concordium/web-sdk": "12.0.2",
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0"
  }
}

{
  "name": "@concordium/wdk-identity-concordium",
  "version": "0.0.0",
  "private": true,
  "description": "Concordium identity companion for the WDK wallet module: identity verification with an identity provider, encrypted identity storage, account creation and recovery from a wallet seed, and proving facts to websites.",
  "type": "module",
  "main": "index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./node": {
      "types": "./types/node.d.ts",
      "default": "./node-extras.js"
    },
    "./verify": {
      "types": "./types/verify.d.ts",
      "default": "./verify.js"
    }
  },
  "files": [
    "index.js",
    "node-extras.js",
    "verify.js",
    "docs",
    "src",
    "types",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/unit/**/*.test.mjs\"",
    "test:integration": "node --test \"test/integration/**/*.test.mjs\"",
    "fixtures": "node test/fixtures/capture.mjs",
    "check:providers": "node scripts/check-providers.mjs",
    "example:verify-identity": "node examples/verify-identity.mjs",
    "example:load-identity": "node examples/load-identity.mjs",
    "example:create-account": "node examples/create-account.mjs",
    "example:wdk-end-to-end": "node examples/wdk-end-to-end.mjs",
    "example:recover-identity": "node examples/recover-identity.mjs",
    "example:resume-after-restart": "node examples/resume-after-restart.mjs",
    "example:server-keeps-identities": "node examples/server-keeps-identities.mjs",
    "example:handle-errors": "node examples/handle-errors.mjs",
    "example:age-check": "node examples/age-check.mjs",
    "example:age-check-v1": "node examples/age-check-v1.mjs",
    "example:company-providers": "node examples/company-identity/list-business-id-providers.mjs",
    "example:company-verify": "node examples/company-identity/verify-company-identity.mjs",
    "example:company-questions": "node examples/company-identity/company-questions.mjs",
    "demo-wallet": "node examples/demo-wallet/server.mjs"
  },
  "keywords": [
    "wdk",
    "wallet",
    "concordium",
    "identity",
    "tether"
  ],
  "author": "Concordium",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Concordium/tether-wdk-concordium.git",
    "directory": "identity"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@concordium/wdk-wallet-concordium": "file:..",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@concordium/rust-bindings": "4.0.1",
    "@concordium/web-sdk": "12.0.2",
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0"
  }
}

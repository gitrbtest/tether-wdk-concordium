{
  "name": "@concordium/wdk-wallet-concordium",
  "version": "0.1.0",
  "description": "WDK wallet module for the Concordium blockchain: account derivation, native CCD, PLT + CIS-2 tokens, sponsored transactions, and single-identity account recovery.",
  "type": "module",
  "main": "index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "src",
    "types",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "example": "node examples/example.mjs",
    "example:send": "node examples/example-send.mjs",
    "example:verify": "node examples/example-verify.mjs",
    "test:onboard:request": "node test/onboard.mjs request",
    "test:onboard:create": "node test/onboard.mjs create",
    "example:token": "node examples/example-token.mjs",
    "example:sponsored": "node examples/example-sponsored.mjs",
    "example:regulated-token": "node examples/example-regulated-token.mjs",
    "test": "node --test test/unit/*.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "test:all": "node --test test/unit/*.test.mjs test/integration/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Concordium/tether-wdk-concordium.git"
  },
  "homepage": "https://github.com/Concordium/tether-wdk-concordium#readme",
  "bugs": {
    "url": "https://github.com/Concordium/tether-wdk-concordium/issues"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "keywords": [
    "wdk",
    "wallet",
    "concordium",
    "ccd",
    "multi-chain",
    "tether"
  ],
  "author": "Concordium",
  "license": "Apache-2.0",
  "dependencies": {
    "@tetherto/wdk-wallet": "1.0.0-beta.23",
    "@concordium/web-sdk": "12.0.2",
    "@grpc/grpc-js": "1.14.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
